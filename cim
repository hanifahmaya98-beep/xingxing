  const search = root.querySelector("#revx-search");
  const prev = root.querySelector("#revx-prev");
  const next = root.querySelector("#revx-next");
  const filters = root.querySelectorAll("[data-filter]");
  if (![track,dots,search,prev,next].every(Boolean)) return;

  let category = "Semua";
  let keyword = "";
  let page = 0;

  const storageKey = "revx-bragatoto-demo-liked-v1";
  let liked = [];

  try {
    const stored = JSON.parse(
      localStorage.getItem(storageKey) || "[]"
    );
    if (Array.isArray(stored)) liked = stored;
  } catch (error) {
    liked = [];
  }

  const escapeHTML = value =>
    String(value).replace(/[&<>"']/g, c => ({
