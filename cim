<script>
 /* =====================================================
   BRAGATOTO FAQ + REVIEW JAVASCRIPT
===================================================== */

(function(){

  "use strict";

  /* ===================================================
     FAQ NAVIGATION
  =================================================== */

  const faqNavigation = document.querySelectorAll(".at-faq-nav");
  const faqPanels = document.querySelectorAll(".at-faq-panel");

  faqNavigation.forEach(function(nav){

    nav.addEventListener("click",function(){

      const target = nav.getAttribute("data-target");

      faqNavigation.forEach(function(item){
        item.classList.remove("active");
      });

      faqPanels.forEach(function(panel){
        panel.classList.remove("active");
      });

      nav.classList.add("active");

      const selectedPanel = document.getElementById(target);

      if(selectedPanel){
        selectedPanel.classList.add("active");
      }

    });

  });


  /* ===================================================
     FAQ ACCORDION
     FIX: HEIGHT DIHITUNG DARI SCROLLHEIGHT
  =================================================== */

  const faqQuestions = document.querySelectorAll(
    ".at-faq-item > button"
  );

  faqQuestions.forEach(function(button){

    button.addEventListener("click",function(){

      const item = button.closest(".at-faq-item");
      const answer = item.querySelector(".at-faq-answer");
      const panel = item.closest(".at-faq-panel");

      const isOpen = item.classList.contains("open");


      /* -----------------------------------------------
         TUTUP ITEM LAIN
      ------------------------------------------------ */

      panel.querySelectorAll(".at-faq-item.open").forEach(function(other){

        if(other !== item){

          other.classList.remove("open");

          const otherAnswer =
            other.querySelector(".at-faq-answer");

          otherAnswer.style.height = "0px";
          otherAnswer.style.opacity = "0";

        }

      });


      /* -----------------------------------------------
         JIKA SUDAH TERBUKA → TUTUP
      ------------------------------------------------ */

      if(isOpen){

        item.classList.remove("open");

        answer.style.height = answer.scrollHeight + "px";

        requestAnimationFrame(function(){

          answer.style.height = "0px";
          answer.style.opacity = "0";

        });

        return;
      }


      /* -----------------------------------------------
         BUKA FAQ
      ------------------------------------------------ */

      item.classList.add("open");

      answer.style.height = "0px";
      answer.style.opacity = "0";

      requestAnimationFrame(function(){

        const answerHeight = answer.scrollHeight;

        answer.style.height = answerHeight + "px";
        answer.style.opacity = "1";

      });


      /* -----------------------------------------------
         SET AUTO SETELAH ANIMASI
      ------------------------------------------------ */

      const transitionHandler = function(event){

        if(
          event.propertyName === "height" &&
          item.classList.contains("open")
        ){

          answer.style.height = "auto";

          answer.removeEventListener(
            "transitionend",
            transitionHandler
          );

        }

      };

      answer.addEventListener(
        "transitionend",
        transitionHandler
      );

    });

  });


  /* ===================================================
     REVIEW SLIDER
  =================================================== */

  const slider = document.querySelector(".at-review-slider");
  const track = document.querySelector(".at-review-track");
  const cards = document.querySelectorAll(".at-review-card");

  const previousButton =
    document.querySelector(".at-review-prev");

  const nextButton =
    document.querySelector(".at-review-next");

  const dotsContainer =
    document.querySelector(".at-review-dots");


  if(
    !slider ||
    !track ||
    !cards.length ||
    !previousButton ||
    !nextButton ||
    !dotsContainer
  ){
    return;
  }


  let currentIndex = 0;
  let autoplayTimer = null;

  let isDragging = false;
  let dragStartX = 0;
  let dragCurrentX = 0;
  let startingTranslate = 0;


  /* ===================================================
     JUMLAH CARD YANG TERLIHAT
  =================================================== */

  function getVisibleCards(){

    if(window.innerWidth <= 600){
      return 1;
    }

    if(window.innerWidth <= 900){
      return 2;
    }

    return 3;

  }


  /* ===================================================
     INDEX MAKSIMUM
  =================================================== */

  function getMaxIndex(){

    return Math.max(
      0,
      cards.length - getVisibleCards()
    );

  }


  /* ===================================================
     JARAK PER CARD
  =================================================== */

  function getCardStep(){

    if(cards.length < 2){
      return cards[0].offsetWidth;
    }

    return cards[1].offsetLeft -
           cards[0].offsetLeft;

  }


  /* ===================================================
     DOTS
  =================================================== */

  function createDots(){

    dotsContainer.innerHTML = "";

    const total =
      getMaxIndex() + 1;

    for(let i = 0; i < total; i++){

      const dot =
        document.createElement("button");

      dot.type = "button";

      dot.className =
        "at-review-dot" +
        (i === currentIndex ? " active" : "");

      dot.setAttribute(
        "aria-label",
        "Tampilkan ulasan " + (i + 1)
      );

      dot.addEventListener("click",function(){

        currentIndex = i;

        updateSlider();

        restartAutoplay();

      });

      dotsContainer.appendChild(dot);

    }

  }


  /* ===================================================
     UPDATE DOT
  =================================================== */

  function updateDots(){

    const dots =
      dotsContainer.querySelectorAll(
        ".at-review-dot"
      );

    dots.forEach(function(dot,index){

      dot.classList.toggle(
        "active",
        index === currentIndex
      );

    });

  }


  /* ===================================================
     UPDATE SLIDER
  =================================================== */

  function updateSlider(){

    const maxIndex =
      getMaxIndex();

    currentIndex =
      Math.max(
        0,
        Math.min(currentIndex,maxIndex)
      );

    const distance =
      getCardStep() * currentIndex;

    track.style.transform =
      "translate3d(-" +
      distance +
      "px,0,0)";

    updateDots();

  }


  /* ===================================================
     NEXT
  =================================================== */

  function nextSlide(){

    if(currentIndex >= getMaxIndex()){

      currentIndex = 0;

    }else{

      currentIndex++;

    }

    updateSlider();

  }


  /* ===================================================
     PREVIOUS
  =================================================== */

  function previousSlide(){

    if(currentIndex <= 0){

      currentIndex = getMaxIndex();

    }else{

      currentIndex--;

    }

    updateSlider();

  }


  previousButton.addEventListener(
    "click",
    function(){

      previousSlide();
      restartAutoplay();

    }
  );


  nextButton.addEventListener(
    "click",
    function(){

      nextSlide();
      restartAutoplay();

    }
  );


  /* ===================================================
     AUTOPLAY
  =================================================== */

  function startAutoplay(){

    clearInterval(autoplayTimer);

    autoplayTimer =
      setInterval(function(){

        nextSlide();

      },5000);

  }


  function restartAutoplay(){

    clearInterval(autoplayTimer);

    startAutoplay();

  }


  /* ===================================================
     MOUSE DRAG
  =================================================== */

  slider.addEventListener(
    "mousedown",
    function(event){

      isDragging = true;

      dragStartX =
        event.clientX;

      startingTranslate =
        getCardStep() * currentIndex;

      track.style.transition =
        "none";

      slider.classList.add("dragging");

      clearInterval(autoplayTimer);

    }
  );


  window.addEventListener(
    "mousemove",
    function(event){

      if(!isDragging){
        return;
      }

      dragCurrentX =
        event.clientX;

      const difference =
        dragCurrentX - dragStartX;

      let newTranslate =
        startingTranslate - difference;

      const maxTranslate =
        getCardStep() * getMaxIndex();

      newTranslate =
        Math.max(
          0,
          Math.min(
            newTranslate,
            maxTranslate
          )
        );

      track.style.transform =
        "translate3d(-" +
        newTranslate +
        "px,0,0)";

    }
  );


  window.addEventListener(
    "mouseup",
    function(){

      if(!isDragging){
        return;
      }

      isDragging = false;

      slider.classList.remove(
        "dragging"
      );

      track.style.transition = "";

      const difference =
        dragCurrentX - dragStartX;


      if(Math.abs(difference) > 50){

        if(difference < 0){

          nextSlide();

        }else{

          previousSlide();

        }

      }else{

        updateSlider();

      }

      startAutoplay();

    }
  );


  /* ===================================================
     TOUCH SWIPE
  =================================================== */

  slider.addEventListener(
    "touchstart",
    function(event){

      dragStartX =
        event.touches[0].clientX;

      startingTranslate =
        getCardStep() * currentIndex;

      isDragging = true;

      track.style.transition =
        "none";

      clearInterval(autoplayTimer);

    },
    {passive:true}
  );


  slider.addEventListener(
    "touchmove",
    function(event){

      if(!isDragging){
        return;
      }

      dragCurrentX =
        event.touches[0].clientX;

      const difference =
        dragCurrentX - dragStartX;

      let newTranslate =
        startingTranslate - difference;

      const maxTranslate =
        getCardStep() * getMaxIndex();

      newTranslate =
        Math.max(
          0,
          Math.min(
            newTranslate,
            maxTranslate
          )
        );

      track.style.transform =
        "translate3d(-" +
        newTranslate +
        "px,0,0)";

    },
    {passive:true}
  );


  slider.addEventListener(
    "touchend",
    function(){

      if(!isDragging){
        return;
      }

      isDragging = false;

      track.style.transition = "";

      const difference =
        dragCurrentX - dragStartX;


      if(Math.abs(difference) > 50){

        if(difference < 0){

          nextSlide();

        }else{

          previousSlide();

        }

      }else{

        updateSlider();

      }

      startAutoplay();

    }
  );


  /* ===================================================
     RESPONSIVE RESIZE
  =================================================== */

  window.addEventListener(
    "resize",
    function(){

      currentIndex =
        Math.min(
          currentIndex,
          getMaxIndex()
        );

      createDots();

      updateSlider();

    }
  );


  /* ===================================================
     INIT
  =================================================== */

  createDots();
  updateSlider();
  startAutoplay();

})();
</script>
