      <path fill="#FBBC04"
        d="M19 5.5V10l4-3.5c0-2.2-1.2-3-2.5-2.1z"/>
    </svg>`;

  const locationIcon = `
    <svg viewBox="0 0 24 24" fill="none"
      stroke="currentColor" stroke-width="1.8"
      stroke-linecap="round" stroke-linejoin="round"
      aria-hidden="true">
      <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0z"/>
      <circle cx="12" cy="10" r="2.5"/>
    </svg>`;

  const thumbIcon = `
    <svg viewBox="0 0 24 24" fill="none"
      stroke="currentColor" stroke-width="1.8"
      stroke-linecap="round" stroke-linejoin="round"
      aria-hidden="true">
      <path d="M7 10v11H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3z"/>
      <path d="M7 10l5-8a3 3 0 0 1 3 3v4h5a2 2 0 0 1 2 2l-1 8a2 2 0 0 1-2 2H7"/>
    </svg>`;

  function getLikes(r) {
    return r.likes + (liked.includes(r.id) ? 1 : 0);
  }

  // Statistik mengikuti kategori dan pencarian
  function updateSummary(items) {
    const count = items.length;

    const average = count
      ? items.reduce((sum,r) => sum + r.rating,0) / count
      : 0;

    const five = items.filter(r => r.rating === 5).length;

    const likes = items.reduce(
      (sum,r) => sum + getLikes(r),0
    );

    root.querySelector("#revx-average").textContent =
      average.toFixed(1);

    root.querySelector("#revx-total").textContent =
      count.toLocaleString("id-ID");

    root.querySelector("#revx-five").textContent =
      five.toLocaleString("id-ID");

    root.querySelector("#revx-likes").textContent =
      likes.toLocaleString("id-ID");

    root.querySelector("#revx-category-title").textContent =
      category === "Semua"
        ? "Semua Ulasan"
        : "Ulasan " + category;

    root.querySelector("#revx-count").textContent =
      count + " ulasan";
  }

  function createCard(r) {
    const isLiked = liked.includes(r.id);

    const initials = r.name
      .split(" ")
      .slice(0,2)
      .map(part => part[0])
      .join("")
