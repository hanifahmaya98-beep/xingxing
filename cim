            ${r.rating}.0 / 5
          </span>
        </div>

        <p class="revx-comment">
          ${escapeHTML(r.comment)}
        </p>

        <div class="revx-card-footer">
          <span class="revx-location">
            ${locationIcon}
            ${escapeHTML(r.location)}
