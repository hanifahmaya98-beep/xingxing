            class="revx-like ${isLiked ? "liked" : ""}"
            data-like="${r.id}"
            aria-pressed="${isLiked}"
            aria-label="Sukai ulasan ${escapeHTML(r.name)}">
            ${thumbIcon}
            <span>${getLikes(r).toLocaleString("id-ID")}</span>
          </button>
        </div>
      </article>
    `;
  }

  function updatePosition() {
    const items = getFiltered();
    const visible = getVisible();
    const maxPage = Math.max(0,items.length-visible);

    page = Math.min(Math.max(page,0),maxPage);

    const firstCard = track.querySelector(".revx-card");
    track.style.transform = "translateX(0)";

    if (firstCard) {
      const gap =
        parseFloat(getComputedStyle(track).gap) || 0;
      const distance =
        firstCard.getBoundingClientRect().width + gap;

      track.style.transform =
        `translateX(-${page * distance}px)`;
    }

    prev.disabled = page === 0;
    next.disabled = page >= maxPage;

    dots.innerHTML = "";

    for (let i=0;i<=maxPage;i++) {
      const dot = document.createElement("button");
      dot.type = "button";
      dot.className =
        "revx-dot" + (i === page ? " active" : "");

      dot.setAttribute(
        "aria-label","Halaman ulasan " + (i+1)
      );

      if (i === page) {
        dot.setAttribute("aria-current","true");
      }

      dot.addEventListener("click",() => {
        page = i;
        updatePosition();
      });

      dots.appendChild(dot);
    }
  }

  function render() {
    const items = getFiltered();

    updateSummary(items);
    track.style.transform = "translateX(0)";

    if (!items.length) {
      track.innerHTML = `
        <div class="revx-empty">
          Tidak ada ulasan yang cocok dengan pencarian.
        </div>`;
      dots.innerHTML = "";
      prev.disabled = true;
      next.disabled = true;
      return;
    }

    track.innerHTML = items.map(createCard).join("");
    updatePosition();
  }

  // FILTER KATEGORI
  filters.forEach(button => {
    button.addEventListener("click",() => {
      category = button.dataset.filter;
      page = 0;

      filters.forEach(item => {
        item.classList.toggle(
          "active",item === button
        );
      });

      render();
    });
  });

  // PENCARIAN
  search.addEventListener("input",() => {
    keyword = search.value.trim().toLowerCase();
    page = 0;
    render();
  });

  // PREVIOUS / NEXT
  prev.addEventListener("click",() => {
    page--;
    updatePosition();
  });

  next.addEventListener("click",() => {
    page++;
    updatePosition();
  });

  // LIKE INTERAKTIF
  track.addEventListener("click",event => {
    const button = event.target.closest("[data-like]");
    if (!button) return;

    const id = Number(button.dataset.like);
    const review = reviews.find(r => r.id === id);
    if (!review) return;

    if (liked.includes(id)) {
      liked = liked.filter(value => value !== id);
    } else {
      liked.push(id);
    }

    try {
      localStorage.setItem(
        storageKey,JSON.stringify(liked)
      );
    } catch (error) {}

    const active = liked.includes(id);

    button.classList.toggle("liked",active);
    button.setAttribute("aria-pressed",String(active));

    button.querySelector("span").textContent =
      getLikes(review).toLocaleString("id-ID");

    updateSummary(getFiltered());
  });

  // SWIPE MOBILE
  let startX = 0;

  const viewport = root.querySelector("#revx-viewport");

  viewport.addEventListener("touchstart",event => {
    startX = event.changedTouches[0].screenX;
  },{passive:true});

  viewport.addEventListener("touchend",event => {
    const difference =
      event.changedTouches[0].screenX-startX;

    if (Math.abs(difference) < 50) return;

    if (difference < 0 && !next.disabled) {
      next.click();
    } else if (difference > 0 && !prev.disabled) {
      prev.click();
    }
  },{passive:true});

  // RESPONSIVE
  let resizeFrame;
  window.addEventListener("resize",() => {
    cancelAnimationFrame(resizeFrame);
    resizeFrame = requestAnimationFrame(updatePosition);
  });

  // INITIAL RENDER
  render();

})();
</script>




