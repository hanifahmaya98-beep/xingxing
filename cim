<script>
/* JS */
(function () {
  const slider = document.querySelector(".game-slider");
  const track = slider.querySelector(".game-track");

  const cards = Array.from(track.children);

  /* Duplikat agar looping tidak terputus */
  cards.forEach(card => {
    track.appendChild(card.cloneNode(true));
  });

  let position = 0;
  let lastTime = performance.now();

  const speed = 45;

  function getLoopWidth() {
    const gap = parseFloat(getComputedStyle(track).gap);
    let width = 0;

    cards.forEach(card => {
      width += card.offsetWidth + gap;
    });

    return width;
  }

  let loopWidth = getLoopWidth();

  /*
    Mulai dari kiri,
    lalu berjalan ke kanan.
  */
  position = -loopWidth;

  function animate(time) {
    const delta = (time - lastTime) / 1000;
    lastTime = time;

    position += speed * delta;

    /*
      Sampai ujung kanan,
      kembali ke awal secara seamless.
    */
    if (position >= 0) {
      position -= loopWidth;
    }

    track.style.transform =
      `translate3d(${position}px,0,0)`;

    requestAnimationFrame(animate);
  }

  window.addEventListener("resize", () => {
    loopWidth = getLoopWidth();

    if (position < -loopWidth) {
      position = -loopWidth;
    }
  });

  requestAnimationFrame(animate);
})();
</script>

