      month: "short",
      year: "numeric",
      timeZone: "UTC"
    }).format(new Date(value + "T12:00:00Z"));

  const getVisible = () =>
    window.innerWidth <= 620 ? 1 :
    window.innerWidth <= 950 ? 2 : 3;

  const getFiltered = () =>
    reviews.filter(r =>
      (category === "Semua" || r.category === category) &&
      [r.name, r.location, r.category, r.comment]
        .some(value =>
          value.toLowerCase().includes(keyword)
        )
    );

  const gmailIcon = `
