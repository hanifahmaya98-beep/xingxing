.features-table tbody tr:hover {
    background: rgba(53, 231, 245, .075);
}

.features-table td {
    color: #bbd0df;
}

.features-table td strong {
    color: gold;
}

/* ==========================================
   ICON COLORS
========================================== */

.icon-gold {
    color: #f4c66c;
    margin-right: 6px;

    text-shadow: 0 0 10px rgba(244, 198, 108, .25);
}

.icon-orange {
    color: #35e7f5;
    margin-right: 6px;

    text-shadow: 0 0 10px rgba(53, 231, 245, .25);
}

/* ==========================================
   STATUS BADGES
========================================== */

.status-badge {
    font-size: 11px;
    font-weight: 700;

    padding: 3px 8px;
    border-radius: 6px;

    display: inline-block;

    transition:
        background .25s ease,
        border-color .25s ease,
        box-shadow .25s ease;
}

/* INSTANT - CYAN */
.status-badge.instant {
    background: rgba(53, 231, 245, .1);
    color: #35e7f5;

    border: 1px solid rgba(53, 231, 245, .3);
}

/* HIGH - GOLD */
.status-badge.high {
    background: rgba(244, 198, 108, .1);
    color: #f4c66c;

    border: 1px solid rgba(244, 198, 108, .3);
}

/* SECURE - BLUE */
.status-badge.secure {
    background: rgba(20, 139, 219, .13);
    color: #7ccfff;

    border: 1px solid rgba(20, 139, 219, .35);
}

/* ACTIVE - CYAN GOLD */
.status-badge.active {
    background: rgba(244, 198, 108, .09);
    color: #f4c66c;

    border: 1px solid rgba(244, 198, 108, .28);
}

/* BADGE HOVER */
.status-badge.instant:hover {
    box-shadow: 0 0 15px rgba(53, 231, 245, .2);
}

.status-badge.high:hover,
.status-badge.active:hover {
    box-shadow: 0 0 15px rgba(244, 198, 108, .2);
}

.status-badge.secure:hover {
    box-shadow: 0 0 15px rgba(20, 139, 219, .2);
}

/* ==========================================
   RESPONSIVE
========================================== */

@media (max-width: 900px) {
    .product-seo-container {
