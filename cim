        padding: 10px 8px;
        font-size: 12.5px;
    }
}

/* ==========================================
   REDUCED MOTION
========================================== */

@media (prefers-reduced-motion: reduce) {
    .product-seo-container,
    .product-img-1to1,
    .features-table tbody tr,
    .status-badge {
        transition: none;
    }
}
