});

/* PARTICLE */
const c=document.querySelector('.auroraParticles'),
x=c.getContext('2d');
function r(){c.width=c.offsetWidth;c.height=c.offsetHeight}
window.onresize=r;r();
let p=[...Array(50)].map(()=>({x:Math.random()*c.width,y:Math.random()*c.height,r:Math.random()*2+1,v:Math.random()+.3}));
(function d(){
  x.clearRect(0,0,c.width,c.height);
  p.forEach(o=>{
    x.beginPath();
    x.arc(o.x,o.y,o.r,0,7);
    x.fillStyle='rgba(250,204,21,.65)';
    x.fill();
    o.y-=o.v;if(o.y<0)o.y=c.height;
  });
  requestAnimationFrame(d);
})();

