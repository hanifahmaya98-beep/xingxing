  max-width:255px;
  aspect-ratio:1/1;
  margin:0 auto 15px;
  border-radius:18px;
  padding:4px;
  background:linear-gradient(
    135deg,#facc15,#38bdf8,#1e40af,#facc15
  );
  background-size:300% 300%;
  animation:apGradient 6s ease infinite;
  box-shadow:
    0 0 25px rgba(250,204,21,.24),
    0 0 35px rgba(56,189,248,.15);
  overflow:hidden;
}

.ap-image {
  width:100%;
  height:100%;
  display:block;
  object-fit:cover;
  border-radius:14px;
  background:#0f172a;
}

.ap-image-shine {
  position:absolute;
  inset:0;
  pointer-events:none;
  background:linear-gradient(
    110deg,
    transparent 30%,
    rgba(255,255,255,.23) 50%,
    transparent 70%
  );
  transform:translateX(-150%);
  animation:apShine 5s infinite;
}

@keyframes apShine {
  55%,100% {transform:translateX(150%)}
}

@keyframes apGradient {
  50% {background-position:100% 50%}
}

/* ACTION BUTTONS */
.ap-actions {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
  margin-bottom:18px;
}

.ap-action {
  min-height:44px;
  display:flex;
  justify-content:center;
  align-items:center;
  gap:9px;
  border-radius:13px;
  text-decoration:none;
  font-size:13px;
  font-weight:900;
  letter-spacing:1px;
  transition:transform .3s,box-shadow .3s;
}

.ap-login {
  color:#fff;
  background:linear-gradient(135deg,#1e40af,#0284c7);
  border:1px solid #38bdf8;
  box-shadow:0 0 17px rgba(56,189,248,.28);
}

.ap-register {
  color:#111827;
  background:linear-gradient(135deg,#fde047,#eab308);
  border:1px solid #fef08a;
  box-shadow:0 0 20px rgba(250,204,21,.3);
}

.ap-action:hover {
  transform:translateY(-3px);
  box-shadow:0 0 27px rgba(250,204,21,.4);
}

/* HEADING */
.ap-heading {
  text-align:center;
  margin-bottom:14px;
}

.ap-heading>span {
  font-size:9px;
  color:#facc15;
  letter-spacing:2px;
}

.ap-heading h2 {
  font-size:20px;
  margin:5px 0;
  color:#fff;
  line-height:1.3;
}

.ap-heading p {
  margin:0;
  font-size:11px;
  color:#94a3b8;
}

/* MEMBER PANEL */
.ap-member-panel {
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:12px;
  padding:13px 16px;
  margin-bottom:15px;
  background:linear-gradient(
    120deg,
    rgba(30,64,175,.38),
    rgba(2,6,23,.8)
  );
  border:1px solid rgba(56,189,248,.28);
  border-radius:14px;
}

.ap-member-panel small {
  color:#93c5fd;
  font-size:10px;
  font-weight:700;
}

.ap-member-count {
  font-size:29px;
  font-weight:900;
  letter-spacing:1px;
  color:#fff;
  font-variant-numeric:tabular-nums;
  text-shadow:0 0 15px rgba(56,189,248,.5);
}

.ap-member-trend {
  padding:6px 9px;
  border-radius:9px;
  background:rgba(52,211,153,.13);
  color:#34d399;
  font-size:11px;
  font-weight:800;
  white-space:nowrap;
}

.ap-member-trend.down {
  color:#fb7185;
  background:rgba(251,113,133,.12);
}

/* STATISTICS */
.ap-statistics {
  display:grid;
  gap:11px;
  padding:13px;
  margin-bottom:14px;
  background:rgba(15,23,42,.65);
  border:1px solid rgba(255,255,255,.09);
  border-radius:14px;
}

.ap-stat-head {
  display:flex;
  justify-content:space-between;
  margin-bottom:6px;
  font-size:11px;
  color:#cbd5e1;
}

.ap-stat-head b {
  color:#fff;
  font-variant-numeric:tabular-nums;
}

.ap-progress {
  height:7px;
  background:#1e293b;
  border-radius:20px;
  overflow:hidden;
}

.ap-progress i {
  display:block;
  height:100%;
  width:0;
  border-radius:20px;
  background:var(--accent);
  box-shadow:0 0 12px var(--accent);
  transition:width 1.6s ease;
}

.ap-show .ap-progress i {
  width:var(--percent);
}

/* WITHDRAW */
.ap-withdraw {
  padding:12px;
  border-radius:14px;
  background:rgba(2,6,23,.65);
  border:1px solid rgba(250,204,21,.22);
}

.ap-withdraw-title {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8px;
  margin-bottom:10px;
}

.ap-withdraw-title strong {
  font-size:12px;
  color:#facc15;
}

.ap-withdraw-title span {
  font-size:9px;
  color:#94a3b8;
  letter-spacing:.5px;
}

.ap-withdraw-list {
  display:grid;
  gap:6px;
}

.ap-wd-row {
  display:grid;
  grid-template-columns:32px minmax(0,1fr) auto;
  align-items:center;
  gap:9px;
  padding:8px;
  border-radius:9px;
  background:rgba(255,255,255,.045);
  border:1px solid rgba(255,255,255,.055);
  animation:apRowIn .45s ease both;
}

.ap-wd-avatar {
  display:grid;
  place-items:center;
  width:32px;
  height:32px;
  border-radius:10px;
  background:linear-gradient(135deg,#1e40af,#0e7490);
  color:#fff;
  font-size:10px;
  font-weight:900;
}

.ap-wd-name {
  min-width:0;
}

.ap-wd-name b {
  display:block;
  font-size:11px;
  color:#e2e8f0;
}

.ap-wd-name small {
  font-size:9px;
  color:#64748b;
}

.ap-wd-right {
  text-align:right;
}

.ap-wd-right b {
  display:block;
  font-size:11px;
  color:#facc15;
}

.ap-wd-right small {
  font-size:9px;
  color:#34d399;
}

@keyframes apRowIn {
  from {
    opacity:0;
    transform:translateY(8px);
  }
  to {
    opacity:1;
    transform:translateY(0);
  }
}

.ap-disclaimer {
  margin:10px 0 0;
  color:#64748b;
  font-size:9px;
  text-align:center;
  line-height:1.5;
}

/* REOPEN */
.ap-reopen {
  position:fixed;
  right:14px;
  bottom:125px;
  z-index:10040;
  display:none;
  padding:11px 15px;
  border-radius:25px;
  border:1px solid #facc15;
  background:linear-gradient(135deg,#020617,#1e40af);
  color:#facc15;
  font-size:11px;
  font-weight:900;
  letter-spacing:.5px;
  cursor:pointer;
  box-shadow:0 0 20px rgba(250,204,21,.35);
  animation:apPulse 2.5s infinite;
}

.ap-reopen.ap-visible {
  display:block;
}

@keyframes apPulse {
  50% {filter:brightness(1.35)}
}

/* MOBILE */
@media(max-width:480px) {
  .ap-overlay {padding:10px}

  .ap-modal {
    width:min(100%,370px);
    max-height:calc(100dvh - 20px);
    border-radius:20px;
  }

  .ap-content {padding:14px}

  .ap-image-wrap {
    max-width:min(190px,48vw);
    margin-bottom:12px;
  }

  .ap-actions {gap:9px;margin-bottom:13px}
  .ap-action {min-height:41px;font-size:12px}
  .ap-heading h2 {font-size:18px}
  .ap-member-count {font-size:26px}
  .ap-statistics {gap:8px;padding:10px}
  .ap-reopen {bottom:115px}
}

@media(max-height:650px) {
  .ap-image-wrap {max-width:125px}
  .ap-content {padding:12px}
  .ap-heading {margin-bottom:8px}
  .ap-actions {margin-bottom:9px}
}

@media(prefers-reduced-motion:reduce) {
  .ap-overlay *,
  .ap-reopen {
    animation:none !important;
    transition:none !important;
  }
  .ap-show .ap-progress i {width:var(--percent)}
}
</style>

<script>
(() => {
  "use strict";

  const overlay = document.getElementById("apOverlay");
  const modal = overlay.querySelector(".ap-modal");
  const closeBtn = document.getElementById("apClose");
  const reopenBtn = document.getElementById("apReopen");
  const membersEl = document.getElementById("apMembers");
  const trendEl = document.getElementById("apTrend");
  const withdrawEl = document.getElementById("apWithdrawList");

  const formatNumber = new Intl.NumberFormat("id-ID");
  const formatMoney = new Intl.NumberFormat("id-ID", {
    style:"currency",
    currency:"IDR",
    maximumFractionDigits:0
  });

  // DATA DEMO - GANTI DENGAN API ASLI UNTUK PRODUKSI
  const demoUsers = [
    "And***92","Riz***21","Bay***77",
    "Dew***08","Put***43","Ari***56",
    "Nad***14","Fer***63","Agu***29",
    "San***81","Raf***36","Yud***45",
    "Mel***19","Han***72","Din***25"
  ];

  const amounts = [
    150000,225000,350000,475000,
    550000,750000,900000,1250000,
    1500000,1750000,2250000
  ];

  let memberCount = 13567;
  let lastFocused = null;

  const randomInt = (min,max) =>
    Math.floor(Math.random()*(max-min+1))+min;

  function updateMembers() {
    const previous = memberCount;

    memberCount = Math.max(
      13400,
      Math.min(13750,memberCount+randomInt(-28,28))
    );

    const change = memberCount-previous;
    const percent = Math.abs(change/previous*100);

    membersEl.textContent = formatNumber.format(memberCount);

    trendEl.classList.toggle("down",change<0);
    trendEl.textContent =
      (change<0?"▼ ":"▲ ")+
      percent.toFixed(2).replace(".",",")+"%";
  }

  function shuffle(items) {
    const arr = [...items];

    for(let i=arr.length-1;i>0;i--) {
      const j = randomInt(0,i);
      [arr[i],arr[j]] = [arr[j],arr[i]];
    }

    return arr;
  }

  function updateWithdraw() {
    const users = shuffle(demoUsers).slice(0,5);

    const fragment = document.createDocumentFragment();

    users.forEach((name,index) => {
      const amount = amounts[randomInt(0,amounts.length-1)];
      const minutes = randomInt(1,25);

      const row = document.createElement("div");
      row.className = "ap-wd-row";
      row.style.animationDelay = `${index*65}ms`;

      const avatar = document.createElement("div");
      avatar.className = "ap-wd-avatar";
      avatar.textContent = name.slice(0,2).toUpperCase();

      const info = document.createElement("div");
      info.className = "ap-wd-name";

      const userName = document.createElement("b");
      userName.textContent = name;

      const time = document.createElement("small");
      time.textContent = `${minutes} menit lalu · Done`;

      info.append(userName,time);

      const right = document.createElement("div");
      right.className = "ap-wd-right";

      const value = document.createElement("b");
      value.textContent = formatMoney.format(amount);

      const status = document.createElement("small");
      status.textContent = "✓ Proses selesai";

      right.append(value,status);
      row.append(avatar,info,right);
      fragment.appendChild(row);
    });

    withdrawEl.replaceChildren(fragment);
  }

  function openPopup() {
    lastFocused = document.activeElement;
    overlay.classList.add("ap-show");
    reopenBtn.classList.remove("ap-visible");
    document.body.style.overflow = "hidden";
    closeBtn.focus();
  }

  function closePopup() {
    overlay.classList.remove("ap-show");
    reopenBtn.classList.add("ap-visible");
    document.body.style.overflow = "";
    if(lastFocused && lastFocused.isConnected) {
      lastFocused.focus();
    }
  }

  closeBtn.addEventListener("click",closePopup);
  reopenBtn.addEventListener("click",openPopup);

  overlay.addEventListener("click",event => {
    if(event.target===overlay) closePopup();
  });

  document.addEventListener("keydown",event => {
    if(!overlay.classList.contains("ap-show")) return;

    if(event.key==="Escape") {
      closePopup();
      return;
    }

    if(event.key==="Tab") {
      const focusable = [
        ...modal.querySelectorAll(
          'button:not([disabled]),a[href]'
        )
      ];

      if(!focusable.length) return;

      const first = focusable[0];
      const last = focusable[focusable.length-1];

      if(event.shiftKey && document.activeElement===first) {
        event.preventDefault();
        last.focus();
      } else if(!event.shiftKey &&
        document.activeElement===last) {
        event.preventDefault();
        first.focus();
      }
    }
  });

  // Simulasi pembaruan data
  updateMembers();
  updateWithdraw();

  setInterval(updateMembers,3500);
  setInterval(updateWithdraw,8000);

  // Popup muncul 1.2 detik setelah halaman siap
  window.addEventListener("load",() => {
    setTimeout(openPopup,1200);
  });
})();
</script>

</body>
</html>
