function ecs_inside($path, $root) {
    $path = rtrim(str_replace('\\', '/', $path), '/');
    $root = rtrim(str_replace('\\', '/', $root), '/');
    if (DIRECTORY_SEPARATOR === '\\') { $path = strtolower($path); $root = strtolower($root); }
    return $path === $root || strpos($path . '/', $root . '/') === 0;
}
function ecs_html($value) { return htmlspecialchars($value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8'); }
function ecs_fail($message, $status = 500) {
    http_response_code($status);
    if (($_GET['route'] ?? '') === 'connector') {
        header('Content-Type: application/json; charset=utf-8');
        echo json_encode(['error' => ['errAccess', $message]], JSON_INVALID_UTF8_SUBSTITUTE);
    } else {
        header('Content-Type: text/plain; charset=utf-8');
        echo $message;
    }
    exit;
}
function ecs_assets() {
    static $bundle;
    if ($bundle !== null) return $bundle;
    $handle = fopen(__FILE__, 'rb');
    fseek($handle, __COMPILER_HALT_OFFSET__);
    $packed = base64_decode(preg_replace('/\s+/', '', stream_get_contents($handle)), true);
    fclose($handle);
    if ($packed === false || !hash_equals(ELFS_ASSET_SHA256, hash('sha256', $packed))) {
        throw new RuntimeException('E_ASSET_CHECKSUM');
