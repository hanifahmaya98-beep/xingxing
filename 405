    if ($data === false || strlen($data) < 4) throw new RuntimeException('E_ASSET_FORMAT');
    $size = unpack('Nsize', substr($data, 0, 4))['size'];
    $bundle = [json_decode(substr($data, 4, $size), true, 512, JSON_THROW_ON_ERROR), substr($data, 4 + $size)];
