    text:"Struktur halaman jelas. Informasi permainan, FAQ, dan layanan tersedia dalam satu tempat."
  }
];


  const track = $("#labReviewTrack");
  const dots = $("#labReviewDots");
  let reviewIndex = 0;
  const liked = new Set();

  track.innerHTML = reviews.map((r,i) => `
    <article class="lab-review">
      <div class="lab-review-head">
        <div class="lab-avatar">${escapeHTML(r.name.slice(-1))}</div>
        <div class="lab-review-name">
          <b>${escapeHTML(r.name)}</b>
          <small>⌖ ${escapeHTML(r.city)} · DEMO</small>
        </div>
        <span class="lab-review-verify">◈</span>
      </div>
      <div class="lab-stars" aria-label="Contoh lima bintang">★★★★★</div>
      <p>${escapeHTML(r.text)}</p>
      <div class="lab-review-foot">
        <small>${escapeHTML(r.date)}</small>
        <button type="button" class="lab-like"
          data-review="${i}" aria-pressed="false"
          aria-label="Sukai contoh ulasan ${i+1}">
          ♡ <span>${r.likes}</span>
        </button>
      </div>
    </article>
  `).join("");

  function perView() {
    if (window.innerWidth <= 700) return 1;
    if (window.innerWidth <= 950) return 2;
    return 3;
  }

  function updateSlider() {
    const cards = $$(".lab-review");
    if (!cards.length) return;
    const max = Math.max(0,cards.length - perView());
    reviewIndex = Math.min(max,Math.max(0,reviewIndex));

    const gap = parseFloat(getComputedStyle(track).gap) || 15;
    const step = cards[0].getBoundingClientRect().width + gap;
    track.style.transform = `translateX(-${reviewIndex * step}px)`;

    dots.innerHTML = "";
    for (let i=0;i<=max;i++) {
      const dot = document.createElement("button");
      dot.type = "button";
      dot.className = i === reviewIndex ? "active" : "";
      dot.setAttribute("aria-label",`Halaman ulasan ${i+1}`);
      dot.setAttribute("aria-current",i === reviewIndex ? "true" : "false");
      dot.addEventListener("click",() => {
        reviewIndex = i;
        updateSlider();
      });
      dots.append(dot);
    }
    $("#labPrev").disabled = reviewIndex === 0;
    $("#labNext").disabled = reviewIndex === max;
  }

  $("#labPrev").addEventListener("click",() => {
    reviewIndex--;
    updateSlider();
  });
  $("#labNext").addEventListener("click",() => {
    reviewIndex++;
    updateSlider();
  });

  track.addEventListener("click",event => {
    const button = event.target.closest(".lab-like");
    if (!button) return;
    const id = Number(button.dataset.review);
    if (liked.has(id)) liked.delete(id);
    else liked.add(id);
    button.setAttribute("aria-pressed",String(liked.has(id)));
    button.querySelector("span").textContent =
      reviews[id].likes + (liked.has(id) ? 1 : 0);
    button.firstChild.textContent = liked.has(id) ? "♥ " : "♡ ";
  });

  let startX = null;
  track.addEventListener("touchstart",e => {
    startX = e.touches[0].clientX;
  },{passive:true});
  track.addEventListener("touchend",e => {
    if (startX === null) return;
    const delta = e.changedTouches[0].clientX - startX;
    if (Math.abs(delta) > 45) {
      reviewIndex += delta < 0 ? 1 : -1;
      updateSlider();
    }
    startX = null;
  },{passive:true});

  
window.addEventListener("resize", updateSlider, {
  passive: true
});

requestAnimationFrame(() => {
  updateSlider();
});


  /* NAVIGATION ACTIVE STATE */
  const navLinks = $$(".lab-nav a");
  navLinks.forEach(link => {
    link.addEventListener("click",() => {
      navLinks.forEach(a => a.classList.remove("active"));
      link.classList.add("active");
    });
  });
})();
</script>

